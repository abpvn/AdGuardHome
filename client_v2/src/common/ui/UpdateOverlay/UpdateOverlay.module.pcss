.overlay {
    position: fixed;
    inset: 0;
    z-index: 110;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: var(--default-page-background);
}

.loader {
    width: 56px;
    height: 56px;
    color: var(--default-product-icon);
}

.message {
    margin-top: 20px;
    color: var(--default-main-text);
    font-size: 28px;
    font-weight: 600;
    text-align: center;
}
