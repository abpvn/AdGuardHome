.wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.refreshButton {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: none;
    background: none;
    color: var(--default-main-text);
    cursor: pointer;
}

.refreshButton:disabled {
    opacity: 0.5;
    cursor: default;
}
